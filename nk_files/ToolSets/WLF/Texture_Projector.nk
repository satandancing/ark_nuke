 }
 Dot {
  name Dot3
  xpos -1003
  ypos -84
 }
clone $C1fe17600 {
  xpos -907
  ypos -94
  selected false
 }
 ApplyMaterial {
  inputs 2
  name ApplyMaterial1
  xpos -737
  ypos -88
 }
 Constant {
  inputs 0
  channels none
  format "2048 2048 0 0 2048 2048 1 square_2K"
  name Constant3
  xpos -991
  ypos 32
 }
 ScanlineRender {
  inputs 2
  conservative_shader_sampling false
  antialiasing high
  projection_mode uv
  motion_vectors_type off
  MB_channel none
  drop_zero_alpha_samples false
  name ScanlineRender1
